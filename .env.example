# Dashboard-safe public values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private server values. Never prefix these with NEXT_PUBLIC_. The worker reads
# the secret directly; the dashboard accepts it only for explicit local dogfood.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TWOFOLD_LOCAL_DOGFOOD=false
TWOFOLD_WORKER_ID=twofold-local-worker
TWOFOLD_POLL_INTERVAL_MS=5000
TWOFOLD_LEASE_SECONDS=60

# Real Alpaca market-data source (worker only).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
TWOFOLD_MARKET_SYMBOLS=LULU,SPY,QQQ
TWOFOLD_MARKET_FEED=sip
TWOFOLD_MARKET_LOOKBACK_DAYS=14
TWOFOLD_MARKET_SOURCE_VERSION=alpaca-sip-raw-1day-v1
TWOFOLD_MARKET_SOURCE_EFFECTIVE_FROM=2026-08-23T00:00:00Z
TWOFOLD_MARKET_LICENSE_SCOPE=private-research

# DeepSeek Harness / persistent worker credential layer only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
