# Public, browser-safe Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local private dogfood only. The dashboard ignores this secret in production
# and unless TWOFOLD_LOCAL_DOGFOOD is exactly true.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TWOFOLD_LOCAL_DOGFOOD=false
